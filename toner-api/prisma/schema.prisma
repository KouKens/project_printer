generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// 操作区分
enum TonerAction {
  REGISTER // 登録（マスタ新規追加）
  RECEIVE // 搬入（在庫加算）
  ISSUE // 持ち出し（在庫減算）
  DISPOSE // 廃棄（搬入累計の範囲内でのみ記録）
  ADJUST // 棚卸し調整（実際に数えた本数に在庫を合わせる）

  @@map("toner_action")
}

/// SNMP のバージョン。機種によって片方しか応答しない
enum SnmpVersion {
  V1  @map("1")
  V2C @map("2c")

  @@map("snmp_version")
}

/// 実機との話し方。**SNMP を持たない機種がある**ので分けて持つ
enum PrinterProtocol {
  /// 標準の Printer-MIB を SNMP で読む。既定
  SNMP
  /// SATO のステータス返送（ENQ をソケットへ 1 バイト）。
  /// レスプリは SNMP を持たず、これでしか状態を読めない
  SATO_ENQ

  @@map("printer_protocol")
}

/// 修理の分類。
/// 前半 4 つは現場の分類そのまま。後半はこの台数で実際に起きている故障を足した
enum RepairCategory {
  /// パーツ交換表示
  PART_REPLACEMENT
  /// センサー汚れ
  SENSOR_DIRT
  /// 用紙詰まり
  PAPER_JAM
  /// インクのかすれ・色合い不調
  PRINT_QUALITY
  /// サービスコール（SC 表示で停止）
  SERVICE_CALL
  /// 給紙不良（重送・給紙されない）。詰まりとは原因が違う
  FEED_FAILURE
  /// 定着不良（印字が剥がれる・こすれて落ちる）
  FUSING_FAILURE
  /// ネットワーク・通信不良（印刷指示が届かない）
  NETWORK
  /// 異音・異臭
  NOISE_SMELL
  /// 電源が入らない
  NO_POWER
  /// その他
  OTHER

  @@map("repair_category")
}

/// 誰が対応したか。業者を呼んだか、自分たちで直したか
enum RepairHandler {
  /// 自分で対応
  IN_HOUSE
  /// 業者を呼んだ
  VENDOR

  @@map("repair_handler")
}

/// 修理の状態。現場の区分をそのまま持つ
enum RepairStatus {
  /// 調査中
  INVESTIGATING
  /// 問い合わせ中（業者へ連絡した）
  INQUIRING
  /// 連絡待ち（業者からの返事待ち）
  AWAITING_REPLY
  /// 見積中
  QUOTING
  /// 決算中
  SETTLING
  /// 発送済
  SHIPPED
  /// 受取済
  RECEIVED
  /// 完了
  DONE

  @@map("repair_status")
}

/// 枚数の集計表で、その機器が何行を占めるか
enum CountLayout {
  /// 合計の 1 行
  TOTAL
  /// モノクロ → カラー の 2 行
  MONO_COLOR
  /// カラー → モノクロ の 2 行。
  /// 集計表の 3 台（002・021・022）が実際にこの順で入っている。
  /// 機器の申告はモノクロが多いほうだが、表の並びに合わせないと貼り付けがずれる
  COLOR_MONO

  @@map("count_layout")
}

/// 注文の状態
enum OrderStatus {
  PENDING // 発注済み・未入荷
  RECEIVED // 入荷済み
  CANCELED // 取消

  @@map("order_status")
}

/// トナーマスタ
model Toner {
  id   String  @id
  name String?

  /// 色。「ブラック」「ライトシアン」「4色パック」など一覧の表記をそのまま持つ。
  /// 色の無い消耗品（メンテナンスボックス・廃トナーボトル）は null
  color String?

  /// リサイクル品・互換品か。純正なら false
  recycled Boolean @default(false)

  /// 在庫がこの本数**以下**になったら一覧で警告する。
  /// 品番ごとに減り方が違うので、共通の閾値ではなくマスタに持つ。
  /// 未設定なら警告しない（0 を入れると「在庫 0 で警告」の意味になる）
  alertThreshold Int? @map("alert_threshold")

  /// 無効にした日時。null なら有効。
  ///
  /// **削除の代わり。** 受付の履歴・注文・請求書がこの品番を指しているので、
  /// 行ごと消すと過去の記録の相手が居なくなる。使わなくなった品番はここに日時を入れ、
  /// 一覧と選択肢から外す。いつ止めたかが分かるよう真偽値ではなく日時で持つ。
  /// 在庫や履歴があっても無効にはできる（元に戻せるので失うものが無い）
  disabledAt DateTime? @map("disabled_at")

  /// 1 本で刷れる枚数（カタログの印刷可能枚数）。
  ///
  /// **1 枚あたりのトナー代を出すために持つ。** `価格 ÷ この枚数` が単価になる。
  /// メーカー公表値は A4・画像面積率 5% が基準で、実際の使い方では前後する。
  /// 実消費の記録が貯まるまでの見積りに使う値。
  /// ドラム・メンテナンスボックスなど寿命が枚数で示される消耗品にも入れる。
  /// 公表値が見つからない品番は未設定（null）にして、単価を出さない
  yieldPages Int? @map("yield_pages")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// 拠点ごとの在庫。**品番マスタは全拠点共通**なので、ここは拠点の数だけ並ぶ
  stocks       TonerStock[]
  entries      TonerEntry[]
  orders       TonerOrder[]
  printers     TonerPrinter[]
  prices       TonerPrice[]
  invoiceLines TonerInvoiceLine[]

  @@map("toners")
}

/// トナーと機器の対応。
/// 1 種類のトナーを複数台で共用する（P500H は P501 が 14 台）ので中間テーブルにする。
/// 逆に 1 台が複数のトナーを使う（カラー機の BK/C/M/Y）ため、多対多になる。
///
/// 相手は SNMP の実機マスタ（printers）ではなく**端末台帳**にしてある。
/// FAX や USB 接続機など SNMP に応答しない機器も台帳には載っており、
/// 実機マスタに寄せると台帳 62 件のうち 19 件が紐づけ不能になるため
model TonerPrinter {
  tonerId        String @map("toner_id")
  printerAssetId Int    @map("printer_asset_id")

  createdAt DateTime @default(now()) @map("created_at")

  toner Toner        @relation(fields: [tonerId], references: [id], onDelete: Cascade)
  asset PrinterAsset @relation(fields: [printerAssetId], references: [id], onDelete: Cascade)

  @@id([tonerId, printerAssetId])
  @@index([printerAssetId])
  @@map("toner_printers")
}

/// 価格の履歴。
/// 値が変わったら行を足し、過去の行は消さない。
/// ある日の価格は「適用開始日がその日以前で最も新しい行」を見る。
/// こうしないと、過去の使用実績を今の単価で計算してしまう
model TonerPrice {
  id      Int    @id @default(autoincrement())
  tonerId String @map("toner_id")

  /// 税別価格（円）。円未満を扱わないので整数
  price Int

  /// この価格の適用開始日。同じトナーで同じ日を二重に持たない
  effectiveFrom DateTime @map("effective_from") @db.Date

  /// 覚書。値上げの理由や見積の番号を残す用
  note String?

  createdAt DateTime @default(now()) @map("created_at")

  toner Toner @relation(fields: [tonerId], references: [id], onDelete: Cascade)

  @@unique([tonerId, effectiveFrom])
  @@index([tonerId, effectiveFrom])
  @@map("toner_prices")
}

/// 在庫テーブル（**品番 × 拠点**ごとの現在数と累計）
///
/// **拠点ごとに数える単位はここ。** 品番マスタ（Toner）は全拠点で共通なので、
/// 「A 拠点の P500H が 3 本、B 拠点の P500H が 1 本」を分けて持てるのはこの表だけ。
/// 行が無い組み合わせは在庫 0 と同じ意味（受け入れて初めて行ができる）
/// 在庫は「品番 × 拠点」。ここが拠点ごとに数えられる唯一の場所
///
/// **4 つの CHECK 制約が付いている**（quantity / received / disposed が 0 以上、
/// disposed <= received）。Prisma のスキーマには CHECK を書けないので、定義は
/// migrations/20260907000000_toner_stock_non_negative/migration.sql にしかない。
/// 列を触るときはそちらも見ること
model TonerStock {
  tonerId   String  @map("toner_id")
  companyId Int     @map("company_id")
  company   Company @relation(fields: [companyId], references: [id])

  /// 現在庫。搬入で増え、持ち出しで減る
  quantity Int @default(0)

  /// 搬入の累計。廃棄できる本数の上限になる
  received Int @default(0)

  /// 廃棄の累計。received を超えられない
  disposed Int @default(0)

  updatedAt DateTime @updatedAt @map("updated_at")

  toner Toner @relation(fields: [tonerId], references: [id], onDelete: Cascade)

  @@id([tonerId, companyId])
  @@index([companyId])
  @@map("toner_stocks")
}

/// 履歴テーブル（誰がいつ何をしたか）
model TonerEntry {
  id      Int         @id @default(autoincrement())
  userId  String      @map("user_id")
  tonerId String      @map("toner_id")
  action  TonerAction

  /// どの拠点の受け払いか。**在庫を動かした先と必ず一致させる**
  /// （TonerStock も「品番 × 拠点」で持っているため）
  companyId Int     @map("company_id")
  company   Company @relation(fields: [companyId], references: [id])

  /// 操作した本数。常に 0 以上。登録は 0
  quantity Int @default(0)

  /// 操作直後の在庫数
  balance Int @default(0)

  /// 搬入日。**搬入のときだけ入る**（既定は受け付けた日）。
  /// 注文の次回搬入日（TonerOrder.deliveryOn）と突き合わせるための日付で、
  /// 記録した日時（createdAt）とは別に持つ。後から入力し直すことがあるため。
  /// @db.Date なので UTC 成分で読み書きする
  receivedOn DateTime? @map("received_on") @db.Date

  createdAt DateTime @default(now()) @map("created_at")

  toner Toner @relation(fields: [tonerId], references: [id])

  @@index([createdAt])
  @@index([tonerId, createdAt])
  @@index([receivedOn])
  /// 拠点で絞る画面（トナー入出状況）が必ず通る列。
  /// 移行（add_company）が作った索引なので、ここに書かないと
  /// 次の migrate dev が「余分な索引」と見なして DROP する
  @@index([companyId])
  @@map("toner_entries")
}

/// 注文テーブル
model TonerOrder {
  id      Int    @id @default(autoincrement())
  tonerId String @map("toner_id")

  /// どの拠点の注文か。搬入して在庫になる先と揃える
  companyId Int     @map("company_id")
  company   Company @relation(fields: [companyId], references: [id])

  /// 注文した人。職員番号（数字 6〜10 桁）か、未入力のときは「ゲスト」。
  /// この列を足す前の注文は持っていないので null を許す
  userId String? @map("user_id")

  /// 注文した本数
  quantity Int

  /// 注文日時。入力値を保持する（登録日時とは別）
  orderedAt DateTime @map("ordered_at")

  /// 次回搬入日（納品予定日）。
  /// 受付の搬入日（TonerEntry.receivedOn）と品番・日付で突き合わせ、
  /// 注文した本数どおり入ったかを見るための鍵。
  /// @db.Date なので UTC 成分で読み書きする
  deliveryOn DateTime? @map("delivery_on") @db.Date

  status OrderStatus @default(PENDING)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  toner Toner @relation(fields: [tonerId], references: [id])

  @@index([status, orderedAt])
  @@index([tonerId, orderedAt])
  @@index([deliveryOn])
  /// 移行が作った索引。書き忘れると次の migrate dev で DROP される
  @@index([companyId])
  @@map("toner_orders")
}

/// 業者から月に 1 通届く請求書。書かれている内容をそのまま持つ。
///
/// **これは「請求された内容」で、搬入の記録とは別物。**
/// 突き合わせて初めて食い違いが分かるので、片方をもう片方から作ることはしない。
/// 金額はすべて税別（マスタの TonerPrice と揃えてある）
model TonerInvoice {
  id Int @id @default(autoincrement())

  /// 請求書の日付
  issuedOn DateTime @map("issued_on") @db.Date

  /// 突き合わせる搬入の期間。**必須**。
  /// 請求書の明細には搬入日が無いので、この期間の搬入をまとめて相手にする。
  /// 画面の既定は「請求日の前月 1 日〜末日」で、締めが違えば直して使う
  periodFrom DateTime @map("period_from") @db.Date
  periodTo   DateTime @map("period_to") @db.Date

  /// 請求書番号。業者側の採番なので一意とは限らない
  invoiceNo String? @map("invoice_no")

  /// 覚書。訂正請求のときに経緯を残す用
  note String?

  /// 突き合わせを確かめた記録。誰がいつ見たか
  checkedAt DateTime? @map("checked_at")
  checkedBy String?   @map("checked_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lines TonerInvoiceLine[]

  @@index([periodTo])
  @@map("toner_invoices")
}

/// 請求書の明細 1 行。
///
/// 品番は画面で検索して選ぶので、マスタに無い消耗品は先にトナー登録が要る。
/// 金額は「単価 × 個数」で出すため持たない（請求書の数字を写すのは単価まで）
model TonerInvoiceLine {
  id        Int    @id @default(autoincrement())
  invoiceId Int    @map("invoice_id")
  tonerId   String @map("toner_id")

  /// 請求された本数
  quantity Int

  /// 請求書に書かれた税別単価（円）。
  /// **画面で品番を選んだ時点でマスタの価格が入り、請求書の数字が違えば直せる。**
  /// マスタに価格が無いまま選んだときは未入力になる
  unitPrice Int? @map("unit_price")

  invoice TonerInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  toner   Toner        @relation(fields: [tonerId], references: [id])

  /// 同じ請求書に同じ品番を 2 行入れさせない。個数はまとめて 1 行で持つ
  @@unique([invoiceId, tonerId])
  @@index([invoiceId])
  @@map("toner_invoice_lines")
}

/// プリンター。IP アドレスで一意に管理する
model Printer {
  id Int @id @default(autoincrement())

  /// SNMP の宛先。登録の入力値
  ipAddress String @unique @map("ip_address")

  /// SNMP コミュニティ名
  community String @default("public")

  /// 応答があったバージョン。次回のポーリングで最初に試す
  version SnmpVersion @default(V1)

  /// この機器の読み方。
  ///
  /// **SATO_ENQ は毎日の定期実行から外れる。** ステータス返送は印刷用のポートへ
  /// こちらから送る操作になるので、画面から人が押したときだけ読む。
  /// そのため状態・取得時刻は最後に手で読んだ時点のものになる
  protocol PrinterProtocol @default(SNMP)

  /// sysName（1.3.6.1.2.1.1.5.0）
  hostName String? @map("host_name")

  /// hrDeviceDescr ないし sysDescr から拾った機種名
  model String?

  serialNumber String? @map("serial_number")
  macAddress   String? @map("mac_address")

  /// 設置場所。SNMP の sysLocation ではなく手入力を優先する
  location String?

  /// 累計カウンタ（prtMarkerLifeCount）。単位は counterUnit を見ること
  pageCount Int? @map("page_count")

  /// pageCount の単位（prtMarkerCounterUnit）。
  ///
  /// **枚数とは限らない。** 一般のプリンターは 7（インプレッション＝枚）だが、
  /// SATO のラベルプリンター（HC4-LX）は 17（メートル）で印字した長さを返す。
  /// 単位を見ずに足すと長さと枚数が混ざるので、集計の前に必ず見る。
  /// 返さない機種は null で、その場合は枚として扱う
  counterUnit Int? @map("counter_unit")

  /// 直近のポーリングで応答があったか
  reachable Boolean @default(false)

  /// 応答がなかったときの理由
  lastError String? @map("last_error")

  /// 最後に問い合わせた時刻。失敗しても進む
  lastPolledAt DateTime? @map("last_polled_at")

  /// 最後に実際に取得できた時刻。
  /// 応答がなくても前回の値は残すので、表示中の情報がいつのものかはこちらで見る
  lastSuccessAt DateTime? @map("last_success_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// 操作パネルに出ている文字（prtConsoleDisplayBufferText）。
  /// 警告表を持たない機種でも、交換時期はここに出ることがある。
  /// protocol が SATO_ENQ のときは、ENQ で読んだ状態の呼び名がここに入る
  consoleText String? @map("console_text")

  readings SupplyReading[]
  alerts   PrinterAlert[]
  pageDays PageCountDaily[]

  @@map("printers")
}

/// 機器が出している警告。部品の交換案内や異常。
/// 解消した警告を残さないため、ポーリングのたびに入れ替える
model PrinterAlert {
  id        Int @id @default(autoincrement())
  printerId Int @map("printer_id")

  /// prtAlertTable の行番号
  alertIndex Int @map("alert_index")

  /// prtAlertSeverityLevel。3 重大 / 4 警告 / 5 状態変化。
  /// 規格外の値（0 など）を返す機種があるので、これだけで判断しない
  severity Int?

  /// prtAlertGroup。どの部位に対する警告か
  alertGroup Int? @map("alert_group")

  /// prtAlertGroupIndex。group が消耗品(11)のとき、対象の supply_index を指す。
  /// これでトナーの警告か交換部品の警告かを見分けられる。-1 は特定不可
  groupIndex Int? @map("group_index")

  /// prtAlertCode。同じ意味でもメーカーで値が違うため判断には使わない
  code Int?

  /// prtAlertDescription。実際に読めるのはこれ
  description String?

  updatedAt DateTime @updatedAt @map("updated_at")

  printer Printer @relation(fields: [printerId], references: [id], onDelete: Cascade)

  @@unique([printerId, alertIndex])
  @@map("printer_alerts")
}

/// 端末台帳。契約・保守まわりの手入力の情報を持つ。
/// SNMP で取れる値（残量・累計枚数・機種）はここには持たない。
/// あちらは実機の今の状態で、こちらは人が管理する台帳なので寿命が違う
model PrinterAsset {
  id Int @id @default(autoincrement())

  /// 持っている拠点。**在庫と受け払いを分ける単位**（Company 参照）。
  /// 機器の状態・印刷枚数・修理履歴は全拠点まとめて見るので、
  /// この列は絞り込みと表示のために持つ。拠点を消せないよう Restrict にする
  companyId Int     @map("company_id")
  company   Company @relation(fields: [companyId], references: [id])

  /// 部署
  department String?

  /// 管理番号。「No.」の列
  no String?

  /// SNMP の宛先。USB 接続の機器は持たないので null を許す。
  /// 台帳の実データに同じ IP を持つ機器が実在するため一意にはしない
  ipAddress String? @map("ip_address")

  maker String?

  /// 型番。同じメーカーでも機種で消耗品が変わるので台帳側にも持つ
  model String?

  serialNumber String? @map("serial_number")

  /// 購入日。@db.Date なので UTC 成分で読み書きする
  purchasedOn DateTime? @map("purchased_on") @db.Date

  /// 購入金額（円）。円未満を扱わないので整数。保守金額（maintFee）と同じ持ち方
  purchasePrice Int? @map("purchase_price")

  /// 契約番号
  contractNo String? @map("contract_no")

  /// 保守を頼んでいる業者。連絡先は業者マスタ側に持つ。
  /// 同じ業者が何台も見ているので、番号を台帳に写さず参照する
  maintVendorId Int?         @map("maint_vendor_id")
  maintVendor   MaintVendor? @relation(fields: [maintVendorId], references: [id], onDelete: SetNull)

  /// 保守契約の有無。台帳の「有」「×」をそのまま持つ
  maintContract String? @map("maint_contract")

  maintStartOn DateTime? @map("maint_start_on") @db.Date
  maintEndOn   DateTime? @map("maint_end_on") @db.Date

  /// 保守取引日
  maintDealOn DateTime? @map("maint_deal_on") @db.Date

  /// 保守金額（円）。円未満を扱わないので整数
  maintFee Int? @map("maint_fee")

  /// 備考。「初期」「リース」など、日付や金額の欄に入っていた数値でない値の受け皿
  note String?

  /// 無効にした日時。null なら有効。
  ///
  /// **削除の代わり。** 修理履歴とトナーの紐づけがこの台帳を指しており、
  /// 行ごと消すと修理履歴も道連れで消える（onDelete: Cascade）。
  /// 入れ替えて使わなくなった機器はここに日時を入れ、一覧と選択肢から外す。
  /// いつ止めたかが分かるよう真偽値ではなく日時で持つ
  disabledAt DateTime? @map("disabled_at")

  /// 枚数の集計表でこの機器が占める行。既定は合計の 1 行。
  ///
  /// **実機の情報からは決められないので台帳に持つ。** 一度も応答していない機器が
  /// 19 台あり、カラー機かどうかを SNMP から判断できない。導出に頼ると行数がずれ、
  /// エクセルへ貼ったとき以降の行が全部ずれる。
  /// 2 行の機器で上下どちらがモノクロかも表ごとに違うため、順序まで持つ
  countLayout CountLayout @default(TOTAL) @map("count_layout")

  repairs RepairRecord[]

  createdAt DateTime @default(now()) @map("created_at")

  /// 更新日。一覧の「更新」ボタンでも現在時刻に進む
  updatedAt DateTime @updatedAt @map("updated_at")

  toners TonerPrinter[]

  @@index([department])
  @@index([ipAddress])
  @@index([maintVendorId])
  /// 移行が作った索引。書き忘れると次の migrate dev で DROP される
  @@index([companyId])
  @@map("printer_assets")
}

/// 機器とトナーを持っている拠点。
///
/// **在庫と受け払いを分ける単位。** 本院と各事業所がそれぞれ機器を持ち、
/// トナーを自分の分だけ数えたいので、持ち出し・搬入・棚卸・注文は
/// この単位で集計する。逆に、機器の状態・印刷枚数・修理履歴・請求書は
/// 全拠点まとめて見る（どこで何が起きているかは横断で見たいため）。
///
/// **品番マスタ（Toner）は拠点で分けない。** 同じ品番を各拠点が使うので、
/// マスタと価格の履歴は 1 か所にまとめ、**在庫（TonerStock）を
/// 「品番 × 拠点」で持つ**ことで拠点ごとの数になる。
/// その拠点が使う品番は、拠点の機器に紐づいたトナーから引ける。
///
/// **これは「見せない」仕組みではない。** 認証を持たないシステムなので、
/// 画面のセレクタで切り替えるだけで誰でも他の拠点を見られる。
/// 閲覧を本当に制限するならログインが要る
model Company {
  id Int @id @default(autoincrement())

  /// 拠点名。セレクタの見出しになるので重複させない
  name String @unique

  /// 並び順。よく使う拠点を上に出すために持つ。同値なら名前順
  sortOrder Int @default(0) @map("sort_order")

  /// 略称や管理上の覚え書き
  note String?

  /// 無効にした日時。null なら有効。
  /// **削除の代わり。** 機器・在庫・履歴がぶら下がっているので消せない
  disabledAt DateTime? @map("disabled_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  assets  PrinterAsset[]
  stocks  TonerStock[]
  entries TonerEntry[]
  orders  TonerOrder[]

  @@map("companies")
}

/// 保守を頼んでいる業者。
///
/// 台帳に会社名と電話番号を直接持たせると、同じ業者を見ている機器のぶんだけ
/// 同じ番号を書き写すことになり、番号が変わったときに直し漏れる。
/// マスタにして台帳から参照する。
model MaintVendor {
  id Int @id @default(autoincrement())

  /// 業者の会社名。台帳から選ぶときの見出しになるので重複させない
  name String @unique

  /// 連絡先。「0942-00-0000（代表）」のように文字も入るので文字列。
  /// 代表・担当者・夜間などで複数あるため配列で持つ
  phones String[] @default([])

  /// この業者が**既定**になるメーカー名（台帳の maker と突き合わせる）。
  /// 台帳に業者の指定が無い機器は、メーカーが一致するこの業者を使う。
  /// 1 つのメーカーを 2 社が名乗ると既定が決まらないので、重複はサービス側で弾く
  makers String[] @default([])

  /// 担当者名や訪問の条件など、番号だけでは足りない情報の受け皿
  note String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  assets PrinterAsset[]

  @@map("maint_vendors")
}

/// 日次の印刷枚数。累計カウンタのスナップショットと、そこから出した 1 日分
model PageCountDaily {
  id        Int @id @default(autoincrement())
  printerId Int @map("printer_id")

  /// 集計対象日。この日に印刷された枚数を pages に持つ
  date DateTime @db.Date

  /// date の終了時点で読んだ累計印刷枚数（prtMarkerLifeCount）。
  /// 内訳が取れる機種では **累計モノクロ + 累計カラー** に一致する
  total Int

  /// 同時点の累計モノクロ枚数（プリンター + コピー）。内訳を返さない機種は null
  totalMono Int? @map("total_mono")

  /// 同時点の累計カラー枚数（プリンター + コピー）。内訳を返さない機種は null
  totalColor Int? @map("total_color")

  /// 機能 × 色の累計。**画面の「累計プリンター」などはこの 6 つを足して出す。**
  /// 合計は保存しない（足し忘れて数が合わなくなるのを防ぐため）。
  /// 出せない機種・機能は null。0 と区別する。
  ///
  /// **スキャナは紙に出ないので total にも累計モノクロ・カラーにも入らない。**
  /// 累計 = プリンター + コピー で、スキャナは読み取り枚数として別に見る
  totalPrintMono  Int? @map("total_print_mono")
  totalPrintColor Int? @map("total_print_color")
  totalCopyMono   Int? @map("total_copy_mono")
  totalCopyColor  Int? @map("total_copy_color")
  totalScanMono   Int? @map("total_scan_mono")
  totalScanColor  Int? @map("total_scan_color")

  /// date 当日の印刷枚数。前回値がない初回と、
  /// カウンタが巻き戻った（機器交換・リセット）ときは null
  pages Int?

  /// 同期間のモノクロ枚数。累計モノクロの差分で出す。内訳を返さない機種は null
  monoPages Int? @map("mono_pages")

  /// 同期間のカラー枚数。累計カラーの差分で出す。内訳を返さない機種は null
  colorPages Int? @map("color_pages")

  /// 同期間の機能 × 色の枚数。上の累計 6 つの差分で出す
  printMonoPages  Int? @map("print_mono_pages")
  printColorPages Int? @map("print_color_pages")
  copyMonoPages   Int? @map("copy_mono_pages")
  copyColorPages  Int? @map("copy_color_pages")
  scanMonoPages   Int? @map("scan_mono_pages")
  scanColorPages  Int? @map("scan_color_pages")

  /// pages が何日分か。1 なら純粋に date 当日の分。
  /// 取得が飛ぶと 2 以上になり、その日数分をまとめた値になる
  spanDays Int @default(1) @map("span_days")

  /// 実際に SNMP を読んだ時刻
  capturedAt DateTime @default(now()) @map("captured_at")

  printer Printer @relation(fields: [printerId], references: [id], onDelete: Cascade)

  @@unique([printerId, date])
  @@index([date])
  @@map("page_count_daily")
}

/// トナー等の残量。ポーリングのたびに上書きする
model SupplyReading {
  id        Int @id @default(autoincrement())
  printerId Int @map("printer_id")

  /// prtMarkerSuppliesTable の行番号
  supplyIndex Int @map("supply_index")

  /// prtMarkerSuppliesDescription
  name String

  /// prtMarkerSuppliesType。名前の表記はメーカーごとに違うので、分類はこれで行う。
  /// 3 トナー / 4 廃トナー / 5 インク / 6 インクカートリッジ / 9 感光体（ドラム）/
  /// 15 定着 / 20 転写ユニット / 21 トナーカートリッジ / 1 その他
  supplyType Int? @map("supply_type")

  /// prtMarkerSuppliesClass。4 は溜まる側（廃トナー等）で、残量は空き容量を指す
  supplyClass Int? @map("supply_class")

  /// 色名（prtMarkerColorantValue）。黒一色の機種では null
  colorant String?

  /// 残量。-1 = 不明、-2 = 取得不可、-3 = 残量あり（数値では取れない）
  level Int

  /// 満量時の値。-1 / -2 は不明
  maxCapacity Int @map("max_capacity")

  /// level と maxCapacity から出したパーセント。出せないときは null
  percent Int?

  updatedAt DateTime @updatedAt @map("updated_at")

  printer Printer @relation(fields: [printerId], references: [id], onDelete: Cascade)

  @@unique([printerId, supplyIndex])
  @@map("supply_readings")
}

/// 修理履歴。1 件の不具合とその対応をまとめて持つ。
///
/// 対象の機器は**端末台帳**を指す。SNMP の実機マスタではなく台帳にしたのは
/// トナーの紐づけと同じ理由で、FAX や USB 接続機など SNMP に応答しない機器も
/// 修理の対象になるため
model RepairRecord {
  id Int @id @default(autoincrement())

  /// 担当。対応した人の名前。あとから思い出して埋めることがあるので任意
  assignee String?

  /// 対象の機器。台帳から選ぶ。必須
  printerAssetId Int @map("printer_asset_id")

  /// 発生日。@db.Date なので UTC 成分で読み書きする。
  /// いつ壊れたか分からないまま直すことがあるので任意
  occurredOn DateTime? @map("occurred_on") @db.Date

  /// 修理分類。分類しきれない時点で残せるよう任意
  category RepairCategory?

  /// 対応区分。既存の履歴は自分で対応した扱いにするので既定は IN_HOUSE。必須
  handledBy RepairHandler @default(IN_HOUSE) @map("handled_by")

  /// 修理内容。何が起きて何をしたか。任意
  detail String?

  /// かかった費用（円・税別）。円未満を扱わないので整数。
  /// 保守で無償だったものは 0、金額が分からないうちは未入力にする。
  /// 保守金額（printer_assets.maint_fee）と並べて契約の損得を見るために持つ
  cost Int? @map("cost")

  /// 復旧日。まだ直っていない、日付が分からないこともあるので任意
  restoredOn DateTime? @map("restored_on") @db.Date

  status RepairStatus @default(INVESTIGATING)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  asset PrinterAsset @relation(fields: [printerAssetId], references: [id], onDelete: Cascade)

  @@index([occurredOn])
  @@index([printerAssetId, occurredOn])
  @@map("repair_records")
}
