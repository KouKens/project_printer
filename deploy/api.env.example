# /etc/toner/api.env にこの内容を置く
#   sudo install -d -m 0750 -o root -g user /etc/toner
#   sudo install -m 0640 -o root -g user api.env.example /etc/toner/api.env
# パスワードが入るので 0640 root:user。user は読めるが他は読めない。
#
# 下の printer は PostgreSQL のロール名で、OS のユーザー名（user）とは別物。
DATABASE_URL="postgresql://printer:ここにパスワード@localhost:5432/printer?schema=public"

# nginx が前段に立つので loopback だけで待つ。
# これを外すと 3000 番が LAN に直接見えてしまう
HOST=127.0.0.1
PORT=3000
